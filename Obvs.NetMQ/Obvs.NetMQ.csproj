<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.1;net10.0</TargetFrameworks>
    <Copyright>Copyright © Christopher Read 2017</Copyright>
    <Version>1.0.0</Version>
    <Description>NetMQ (ZeroMQ) transport for Obvs: UseNetMq(...). No broker: a service binds TCP ports, and its clients connect to them.</Description>
    <PackageTags>$(PackageTags) netmq zeromq</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="NetMQ" />
  </ItemGroup>
  <ItemGroup>
    <!-- Apps that install only this package get the analyzers and generator Obvs ships -->
    <ProjectReference Include="..\Obvs\Obvs.csproj" PrivateAssets="contentfiles;build" />
  </ItemGroup>
</Project>