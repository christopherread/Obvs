<Project Sdk="Microsoft.NET.Sdk">
  <!-- A v6 app on the published 6.x packages, for Obvs.RabbitMQ.Tests' TestV6Interop. It runs in its own process, so its
       Obvs 6 assemblies never load beside v7's. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Obvs" VersionOverride="6.0.31" />
    <PackageReference Include="Obvs.RabbitMQ" VersionOverride="6.0.31" />
    <PackageReference Include="Obvs.Serialization.Json" VersionOverride="6.0.31" />
  </ItemGroup>
</Project>
