<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0;net10.0</TargetFrameworks>
    <Copyright>Copyright © Christopher Read 2026</Copyright>
    <Version>1.0.0</Version>
    <Description>Amazon SQS and SNS transport for Obvs: UseAmazonSqs(...). Commands and requests on queues a service's instances share, events on an SNS topic, with dead-lettering.</Description>
    <PackageTags>$(PackageTags) aws sqs sns</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.SimpleNotificationService" />
    <PackageReference Include="AWSSDK.SQS" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Obvs.AmazonSqs.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Obvs\Obvs.csproj" />
  </ItemGroup>
</Project>
