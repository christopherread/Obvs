<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <!-- Libraries -->
    <ItemGroup>
        <PackageVersion Include="Apache.NMS.ActiveMQ" Version="1.8.0"/>
        <PackageVersion Include="App.Metrics.Abstractions" Version="4.1.0"/>
        <PackageVersion Include="Confluent.Kafka" Version="1.5.2"/>
        <PackageVersion Include="MessagePack" Version="1.9.11"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="5.0.0"/>
        <PackageVersion Include="MsgPack.Cli" Version="1.0.1"/>
        <PackageVersion Include="NATS.Client" Version="0.11.0"/>
        <PackageVersion Include="NEST" Version="7.10.0"/>
        <PackageVersion Include="NetJSON" Version="1.3.7"/>
        <PackageVersion Include="NetMQ" Version="4.0.1.6"/>
        <PackageVersion Include="Newtonsoft.Json" Version="12.0.3"/>
        <PackageVersion Include="NLog" Version="4.7.5"/>
        <PackageVersion Include="protobuf-net" Version="2.4.6"/>
        <PackageVersion Include="RabbitMQ.Client" Version="5.0.1"/>
        <PackageVersion Include="System.Reactive" Version="5.0.0"/>
        <PackageVersion Include="System.Reflection.Emit.Lightweight" Version="4.7.0"/>
        <PackageVersion Include="YamlDotNet.Signed" Version="6.0.0"/>
    </ItemGroup>
    <!-- Tests -->
    <ItemGroup>
        <PackageVersion Include="FakeItEasy" Version="9.0.1"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <!-- Keep in step with System.Reactive: 6.0.0+ pulls in a newer System.Reactive -->
        <PackageVersion Include="Microsoft.Reactive.Testing" Version="5.0.0"/>
        <PackageVersion Include="xunit" Version="2.9.3"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1"/>
    </ItemGroup>
</Project>
