<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0;net10.0</TargetFrameworks>
    <Copyright>Copyright © Christopher Read 2017</Copyright>
    <Version>1.0.0</Version>
    <Description>Kafka transport for Obvs: UseKafka(...), including Confluent Cloud, Amazon MSK and Azure Event Hubs.</Description>
    <PackageTags>$(PackageTags) kafka confluent</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="protobuf-net" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Obvs.Kafka.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Apps that install only this package get the analyzers and generator Obvs ships -->
    <ProjectReference Include="..\Obvs\Obvs.csproj" PrivateAssets="contentfiles;build" />
  </ItemGroup>
</Project>