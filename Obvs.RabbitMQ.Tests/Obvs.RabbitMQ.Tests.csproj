<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Tests v6's fluent configuration, which is obsolete in v7 -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Obvs.RabbitMQ\Obvs.RabbitMQ.csproj" />
    <ProjectReference Include="..\Obvs.Serialization.Json\Obvs.Serialization.Json.csproj" />
    <ProjectReference Include="..\Obvs.Serialization.ProtoBuf\Obvs.Serialization.ProtoBuf.csproj" />
  </ItemGroup>
  <!-- TestV6Interop runs the v6 app from its own output folder, where its 6.x assemblies don't meet v7's -->
  <ItemGroup>
    <ProjectReference Include="..\Obvs.V6InteropApp\Obvs.V6InteropApp.csproj" ReferenceOutputAssembly="false" Private="false" />
    <AssemblyMetadata Include="V6InteropApp" Value="$(MSBuildThisFileDirectory)../Obvs.V6InteropApp/bin/$(Configuration)/net10.0/Obvs.V6InteropApp.dll" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FakeItEasy" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Reactive.Testing" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>