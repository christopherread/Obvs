<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0;net10.0</TargetFrameworks>
    <Description>MessagePack-CSharp serialization for Obvs: SerializedWith(new MessagePackCSharpMessageSerializer(), ...).</Description>
    <PackageTags>$(PackageTags) messagepack serialization</PackageTags>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <!-- Apps that install only this package get the analyzers and generator Obvs ships -->
    <ProjectReference Include="..\Obvs\Obvs.csproj" PrivateAssets="contentfiles;build" />
  </ItemGroup>

</Project>
