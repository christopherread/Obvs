<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0;net10.0</TargetFrameworks>
    <Copyright>Copyright © Christopher Read 2026</Copyright>
    <Version>1.0.0</Version>
    <Description>Azure Service Bus transport for Obvs: UseAzureServiceBus(...). Commands and requests on queues a service's instances share, events on a topic, with dead-lettering.</Description>
    <PackageTags>$(PackageTags) azure azureservicebus</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Messaging.ServiceBus" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Obvs.AzureSB.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Apps that install only this package get the analyzers and generator Obvs ships -->
    <ProjectReference Include="..\Obvs\Obvs.csproj" PrivateAssets="contentfiles;build" />
  </ItemGroup>
</Project>
