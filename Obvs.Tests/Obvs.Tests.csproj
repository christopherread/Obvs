<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Tests v6's fluent configuration, which is obsolete in v7 -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>    
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Company>Christopher Read</Company>
    <Copyright>Copyright © Christopher Read 2014</Copyright>
    <Authors />
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FakeItEasy" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Reactive.Testing" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Obvs\Obvs.csproj" />
    <ProjectReference Include="..\Obvs.Testing\Obvs.Testing.csproj" />
    <!-- The generator the Obvs package ships, as a project using the package gets it -->
    <ProjectReference Include="..\Obvs.Generators\Obvs.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>