<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0;net10.0</TargetFrameworks>
    <Copyright>Copyright © Christopher Read 2026</Copyright>
    <Version>1.0.0</Version>
    <Description>In-memory transport and test harness for Obvs: test services end to end without a broker or fixed delays.</Description>
    <PackageTags>$(PackageTags) testing in-memory</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' != 'net10.0' ">
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Obvs\Obvs.csproj" />
  </ItemGroup>
</Project>
