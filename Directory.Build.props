<Project>
    <!-- SourceLink and Symbols (SourceLink is built into the .NET 8+ SDK) -->
    <PropertyGroup>
        <RepositoryUrl>https://github.com/christopherread/Obvs</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <DebugType>portable</DebugType>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>
    <!-- The packages ship their XML docs, and every public member in them is documented: a missing one fails the build -->
    <PropertyGroup Condition="$([System.String]::Copy(';Obvs;Obvs.ActiveMQ;Obvs.AmazonSqs;Obvs.AzureSB;Obvs.Kafka;Obvs.Mcp;Obvs.NATS;Obvs.NetMQ;Obvs.RabbitMQ;Obvs.Serialization.Json;Obvs.Serialization.MessagePack;Obvs.Serialization.ProtoBuf;Obvs.Testing;').Contains(';$(MSBuildProjectName);'))">
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
        <!-- Comments document the parameters that need it, not always all of them -->
        <NoWarn>$(NoWarn);CS1573</NoWarn>
    </PropertyGroup>
    <!-- Every test project can dump a hung test run, as CI asks it to. The log names the tests still running. -->
    <ItemGroup Condition="'$(MSBuildProjectName)' == 'Obvs.Samples' Or $(MSBuildProjectName.EndsWith('.Tests'))">
        <PackageReference Include="Microsoft.Testing.Extensions.HangDump"/>
    </ItemGroup>
    <!-- License -->
    <PropertyGroup>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\LICENSE.txt" Pack="true" PackagePath="$(PackageLicenseFile)"/>
    </ItemGroup>
</Project>