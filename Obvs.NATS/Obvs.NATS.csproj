<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0;net10.0</TargetFrameworks>
    <!-- C# 9 to set NATS.Net's init-only options (net472 and netstandard2.0 default to C# 7.3) -->
    <LangVersion>9.0</LangVersion>
    <Copyright>Copyright © Christopher Read 2017</Copyright>
    <Version>1.0.0</Version>
    <Description>NATS transport for Obvs: UseNats(...) for core NATS, and UseNatsJetStream(...) for JetStream, with consumers a service's instances share and dead-lettering.</Description>
    <PackageTags>$(PackageTags) nats jetstream</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="NATS.Client.Core" />
    <PackageReference Include="NATS.Client.JetStream" />
    <PackageReference Include="protobuf-net" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Obvs.NATS.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Apps that install only this package get the analyzers and generator Obvs ships -->
    <ProjectReference Include="..\Obvs\Obvs.csproj" PrivateAssets="contentfiles;build" />
  </ItemGroup>
</Project>