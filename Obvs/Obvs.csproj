<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0;net10.0</TargetFrameworks>
    <Copyright>Copyright © Christopher Read 2017</Copyright>
    <Version>1.0.0</Version>
    <Description>Messaging between .NET services: commands, events, requests and responses over RabbitMQ, Kafka, NATS, ActiveMQ, Azure Service Bus, Amazon SQS or NetMQ. Hosting with dependency injection, handlers, Rx streams, System.Text.Json, OpenTelemetry, analyzers and a source generator.</Description>
    <PackageTags>$(PackageTags) rx reactive commands events requests</PackageTags>
  </PropertyGroup>
  <ItemGroup Condition=" '$(TargetFramework)' != 'net472' ">
    <PackageReference Include="Microsoft.Extensions.DependencyModel" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' != 'net10.0' ">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.Threading.Channels" />
  </ItemGroup>
  <!-- The [ObvsMessages] source generator, and the analyzers and their code fixes, ship in this package, so projects
       using Obvs get them -->
  <ItemGroup>
    <ProjectReference Include="..\Obvs.Generators\Obvs.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Obvs.Analyzers\Obvs.Analyzers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\Obvs.Analyzers.CodeFixes\Obvs.Analyzers.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Obvs.Generators\bin\$(Configuration)\netstandard2.0\Obvs.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\Obvs.Analyzers\bin\$(Configuration)\netstandard2.0\Obvs.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="..\Obvs.Analyzers.CodeFixes\bin\$(Configuration)\netstandard2.0\Obvs.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Obvs.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>
</Project>
